#include <windows.h>

1 RT_MANIFEST "Application.manifest"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION 1,5,0,0
    PRODUCTVERSION 1,5,0,0
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS 0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204B0"
        BEGIN
            VALUE "FileDescription", "Slotted Aloha 채널 경쟁 상황 시뮬레이션"
            VALUE "ProductName", "Slotted Aloha 채널 경쟁 상황 시뮬레이션"
            VALUE "InternalName", "SlottedAlohaSimulation"
            VALUE "OriginalFilename", "SlottedAlohaSimulation.exe"
            VALUE "FileVersion", "1.5.0.0"
            VALUE "ProductVersion", "1.5.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200
    END
END
